RACKSTATS_MODE=nas
RACKSTATS_BIND=0.0.0.0
RACKSTATS_PORT=4300
RACKSTATS_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
RACKSTATS_INTERVAL=5
RACKSTATS_LABEL=Synology
RACKSTATS_PROC_ROOT=/host/proc
RACKSTATS_STORAGE_PATH=/monitored/storage
RACKSTATS_INTERFACE=eth0
RACKSTATS_TEMPERATURE_FILE=
RACKSTATS_TLS_CERT=secrets/nas.crt
RACKSTATS_TLS_KEY=secrets/nas.key
RACKSTATS_ALLOW_HTTP=0
# Set these to the UID/GID of the account that owns this project/certificates.
RACKSTATS_UID=1000
RACKSTATS_GID=1000
# This small empty directory must be on the NAS volume whose capacity you want.
NAS_STORAGE_PROBE=/volume1/docker/exor-rackstats/storage-probe
