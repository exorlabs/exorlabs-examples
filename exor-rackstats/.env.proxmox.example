RACKSTATS_MODE=proxmox
RACKSTATS_BIND=0.0.0.0
RACKSTATS_PORT=4310
RACKSTATS_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN
RACKSTATS_INTERVAL=5
RACKSTATS_LABEL=Proxmox
RACKSTATS_TLS_CERT=secrets/proxmox.crt
RACKSTATS_TLS_KEY=secrets/proxmox.key
RACKSTATS_ALLOW_HTTP=0
RACKSTATS_UID=1000
RACKSTATS_GID=1000
PVE_URL=https://pve.example.lan:8006
PVE_NODE=REPLACE_WITH_NODE_NAME
PVE_TOKEN_ID=stats@pve!display
PVE_TOKEN_SECRET=REPLACE_WITH_PVE_API_TOKEN_SECRET
PVE_CA_FILE=secrets/pve-root-ca.pem
